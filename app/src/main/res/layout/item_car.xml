<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".LogInActivity"
    android:gravity="center"
    android:paddingVertical="12dp"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="300sp"
        android:layout_height="90sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/CarNameTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#e9d8a6"
            android:text="Name"
            android:layout_marginHorizontal="10sp"
            android:textSize="20sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/CarNameTxtInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#e9d8a6"
            android:textSize="20sp"
            android:text="carname"
            android:layout_marginHorizontal="10sp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/TeamNameTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#e9d8a6"
            android:text="Team:"
            android:layout_marginHorizontal="10sp"
            android:textSize="20sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/TeamNameTxtInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#e9d8a6"
            android:textSize="20sp"
            android:text="teamName"
            android:layout_marginHorizontal="10sp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/EngineNameTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#e9d8a6"
            android:text="Engine:"
            android:layout_marginHorizontal="10sp"
            android:textSize="20sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/EngineNameTxtInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#e9d8a6"
            android:textSize="20sp"
            android:text="enginename"
            android:layout_marginHorizontal="10sp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/LikesTxtInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6sp"
        android:text="Likes: 0"
        android:textColor="#e9d8a6"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/garageActionsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/publishBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="#e9d8a6"
            android:text="Publish"
            android:textColor="#780000"
            android:visibility="gone" />

        <Button
            android:id="@+id/deleteBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="#780000"
            android:text="Delete"
            android:textColor="#e9d8a6"
            android:visibility="gone" />

    </LinearLayout>

    <Button
        android:id="@+id/likeBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#e9d8a6"
        android:text="Like"
        android:textColor="#780000"
        android:visibility="gone" />
</LinearLayout>
