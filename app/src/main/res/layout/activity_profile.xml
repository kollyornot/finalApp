<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#c1121f"
    android:fillViewport="true"
    tools:context=".ProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/backBtn"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="top|left"
            android:layout_marginHorizontal="10sp"
            android:layout_marginVertical="10sp"
            android:backgroundTint="#e9d8a6"
            android:text="✕"
            android:textColor="#780000"
            android:textSize="29sp" />

        <ImageView
            android:id="@+id/avatarImage"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/profile_button_background"
            android:padding="18dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile" />

        <TextView
            android:id="@+id/profileNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Profile"
            android:textColor="#e9d8a6"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/profileEmailText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#e9d8a6"
            android:textSize="16sp" />

        <Button
            android:id="@+id/changeNameBtn"
            android:layout_width="300dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#e9d8a6"
            android:text="Change name"
            android:textColor="#780000"
            android:textSize="22sp" />

        <Button
            android:id="@+id/galleryAvatarBtn"
            android:layout_width="300dp"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#e9d8a6"
            android:text="Choose from gallery"
            android:textColor="#780000"
            android:textSize="20sp" />

        <Button
            android:id="@+id/cameraAvatarBtn"
            android:layout_width="300dp"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#e9d8a6"
            android:text="Take photo"
            android:textColor="#780000"
            android:textSize="20sp" />

        <Button
            android:id="@+id/logoutBtn"
            android:layout_width="300dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#780000"
            android:text="Log out"
            android:textColor="#e9d8a6"
            android:textSize="22sp" />


    </LinearLayout>

</ScrollView>
